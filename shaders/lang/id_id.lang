# Judul Layar
screen.LIGHTING=Pencahayaan & Atmosfer
screen.SHADOWS=Konfigurasi Bayangan
screen.SKY=Langit & Awan
screen.WATER=Air & Refleksi
screen.WORLD=Dunia & Tumbuhan

# Profil

# Opsi Pencahayaan
option.SSAO=Screen-Space Ambient Occlusion
option.SSAO.comment=Oklusi screen-space meredupkan fraksi ambient tersimpan, sehingga cahaya langsung dan emisi kira-kira tetap terjaga. Mode setengah resolusi dapat memakai history temporal tersendiri.
option.SSAO_SAMPLES=Jumlah Sampel SSAO
option.SSAO_SAMPLES.comment=Banyaknya sampel kedalaman untuk menghitung oklusi. Nilai rendah lebih ramah untuk perangkat kentang.
option.SSGI=Cahaya Pantul Diffuse
option.GI_SAMPLES=Jumlah Ray Cahaya
option.GI_STRENGTH=Kekuatan Pantulan Cahaya
option.VOLUMETRIC_LIGHT=Berkas Cahaya (God Rays)
option.VOLUMETRIC_LIGHT.comment=Menampilkan sorot cahaya matahari di udara.
option.VL_SAMPLES=Langkah Sampel God Ray
option.NIGHT_BRIGHTNESS=Kecerahan Cahaya Bulan
option.CAVE_BRIGHTNESS=Kecerahan Gua & Interior
option.CAVE_BRIGHTNESS.comment=Tingkat kecerahan minimal di dalam gua atau ruangan tertutup agar tidak gelap gulita.
option.TORCH_BRIGHTNESS=Kecerahan Obor & Lentera

# Opsi Bayangan
option.SHADOWS=Bayangan Real-Time
option.SHADOWS.comment=Membuat bayangan dinamis matahari dan bulan. Mematikan fitur ini memberikan lonjakan FPS terbesar.
option.shadowMapResolution=Resolusi Peta Bayangan
option.shadowDistance=Jarak Bayangan
option.SHADOW_SAMPLES=Kelembutan Sampel Bayangan
option.SHADOW_SAMPLES.comment=1 sampel menghasilkan bayangan tajam seketika (sangat optimal untuk perangkat kentang). Sampel lebih tinggi menghasilkan gradasi halus.
option.SHADOW_ALPHA_TEST=Uji Alpha Bayangan (Cutout)
option.SHADOW_ALPHA_TEST.comment=Memungkinkan daun dan rumput membentuk bayangan tembus cahaya detail. Matikan untuk mempercepat rendering GPU.
option.CLOUD_SHADOWS=Bayangan Awan Bergerak
option.sunPathRotation=Sudut Rotasi Matahari

# Opsi Langit & Awan
option.CLOUDS=Awan
value.CLOUDS.0=Mati
value.CLOUDS.1=Cepat 2D
value.CLOUDS.2=Volumetrik 3D
option.CLOUDS.comment=Mode render awan. Cepat 2D sangat ringan dan mulus untuk perangkat kentang/low-end. Volumetrik 3D memberikan awan raymarch yang megah dan realistis.
option.CLOUD_DETAIL=Detail Gumpalan Awan (Noise 3D)
option.CLOUD_DETAIL.comment=Menambahkan mikro-tekstur gumpalan detail pada awan. Matikan pada perangkat kentang untuk melewati kalkulasi noise 3D.
option.CLOUD_STEPS=Langkah Raymarch Awan
option.CLOUD_COVERAGE=Kepadatan Awan
option.CLOUD_ALTITUDE=Ketinggian Dasar Awan
option.STARS=Bintang Langit Malam
option.SUN_MOON_GLOW=Pendar Korona Matahari & Bulan
option.FOG_ENABLED=Kabut Atmosfer
option.FOG_DENSITY=Kepadatan Kabut

# Opsi Air
option.WATER_REFRACTION=Pembiasan Cahaya di Bawah Air
option.WATER_REFRACTION.comment=Membias permukaan di bawah air. Matikan pada perangkat kentang untuk menghindari pembacaan ganda buffer kedalaman.
option.WATER_CAUSTICS=Pola Kaustik Dasar Air
option.WATER_CAUSTICS.comment=Tekstur kaustik halus hasil generasi dengan dua lapis animasi, filter piksel dan bayangan terrain/awan. Memerlukan Iris.
option.SSR=Refleksi Screen-Space
option.SSR.comment=Pantulan layar dengan fallback light-space opsional pada permukaan yang terlihat matahari. Material matte memakai langit lebar. Bukan geometri dunia penuh.
option.SSR_STEPS=Langkah Ray Refleksi
option.WATER_OCTAVES=Oktaf Gelombang Air
option.WATER_OCTAVES.comment=Gelombang silang, riak kecil dan riak mikro. 6/7 lapis juga memperhalus filter pantulan. Detail subpiksel menjadi lebar highlight.
option.WATER_WAVES.comment=Kekuatan gelombang silang, riak hujan dan buih tepian. Mengubah normal optik, bukan geometri fluida.
option.WATER_WAVES=Kekuatan Riak Gelombang Air
option.WATER_CLARITY=Kejernihan Air
option.WATER_ROUGHNESS.comment=Lebar dasar highlight dan pantulan. Riak kecil menambah roughness tersaring; 0.10 menjaga pantulan dekat lebih tajam.
option.WATER_ROUGHNESS=Kekasaran Permukaan Air

# Opsi Dunia & Tumbuhan
option.WAVING_FOLIAGE=Gerakan Angin Tanaman
option.WAVING_PLANTS=Goyangan Rumput, Bunga & Tanaman
option.WAVING_LEAVES=Goyangan Daun Pohon
option.WIND_SPEED=Kecepatan Angin
option.RAIN_PUDDLES=Genangan Air Hujan Dinamis
option.RAIN_PUDDLES.comment=Membuat genangan basah mengkilap saat hujan. Matikan untuk meningkatkan FPS saat cuaca hujan.
option.RESOURCE_NORMALS=Normal Map Resource Pack

# Opsi Pasca-Proses & Color Grading
option.TONEMAP_OPERATOR=Kurva Tonemapping
value.TONEMAP_OPERATOR.0=ACES Filmic
value.TONEMAP_OPERATOR.1=Gaya AgX (Pendekatan)
value.TONEMAP_OPERATOR.2=Khronos PBR Netral
value.TONEMAP_OPERATOR.3=Uncharted 2 (Hable)
value.TONEMAP_OPERATOR.4=Reinhard-Jodie
value.TONEMAP_OPERATOR.5=Linear (Clipping)
option.TONEMAP_OPERATOR.comment=Kompresi highlight HDR: ACES, pendekatan sederhana gaya AgX, PBR Netral, Hable, Reinhard-Jodie atau linear dengan clipping.
option.COLOR_VIBRANCE=Vibrance Pintar
option.COLOR_VIBRANCE.comment=Secara cerdas meningkatkan warna-warna redup/pucat tanpa membuat warna yang sudah terang menjadi terlalu mencolok atau merusak warna kulit.
option.COLOR_SATURATION=Saturasi Warna
option.COLOR_CONTRAST=Kontras Warna
option.EXPOSURE=Pencahayaan Kamera (Exposure)
option.COLOR_TEMPERATURE=Keseimbangan Putih (Suhu Warna)
option.COLOR_TEMPERATURE.comment=Menggeser keseimbangan warna antara hangat kekuningan/emas dan dingin kebiruan.
option.COLOR_TINT=Keseimbangan Putih (Tint Warna)
option.COLOR_TINT.comment=Menyesuaikan pergeseran warna antara hijau dan magenta/ungu.
option.BLOOM=Efek Pendaran Cahaya (Bloom)
option.BLOOM.comment=Memberikan pendaran lembut di sekitar sumber cahaya terang. Otomatis dilewati saat dimatikan.
option.BLOOM_STRENGTH=Kekuatan Bloom
option.TAA=Stabilisasi Temporal
option.TAA.comment=History HDR dengan validasi depth, clipping warna, dan reproyeksi kamera. Gunakan bersama FXAA untuk tepi geometri; tidak memakai jitter.
option.TAA_BLEND=Akumulasi Temporal TAA
option.TAA_BLEND.comment=Bobot akumulasi riwayat frame sebelumnya. Nilai lebih tinggi memberikan stabilitas maksimal; nilai lebih rendah meningkatkan responsivitas gerakan.
option.FXAA=Penghalusan Tepi (FXAA)
option.FXAA.comment=Filter penghalus tepi berbasis screen-space. Bekerja bersama TAA untuk memberikan tepi halus tanpa getaran kamera.
option.COLOR_DITHERING=Dithering Warna Teratur

screen.PARTICLES=Partikel & Cuaca
option.MOTION_BLUR=Motion Blur Ringan
option.MOTION_BLUR.comment=Satu switch dengan 2 sampel seimbang tanpa dither. Melewati kamera diam, tangan, air dan batas depth; jejak blur dibatasi.
option.RESOURCE_SPECULAR=Kilap & Emisi LabPBR
option.RESOURCE_SPECULAR.comment=LabPBR 1.3: F0 linear, konstanta logam ID 230-237 dengan tint albedo, fallback F0 albedo untuk logam lain, emisi dan subsurface. Porositas mengatur penggelapan basah serta genangan.
option.SPECULAR_AA=Kurangi Kedipan Kilap
option.SPECULAR_AA.comment=Melebarkan kilap yang lebih kecil dari piksel agar air dan normal map tidak berkelip berlebihan.
option.SOFT_PARTICLES=Pertemuan Partikel Halus
option.SOFT_PARTICLES.comment=Memudarkan partikel transparan saat menyentuh blok padat. Tidak menambah partikel baru.
option.PARTICLE_SOFTNESS=Jarak Pudar Partikel
option.PARTICLE_LIGHTING=Cahaya & Bayangan Partikel
option.WEATHER_OPACITY=Kepekatan Hujan & Salju

option.POM=Tekstur Timbul (POM)
option.POM.comment=Kedalaman dari alpha normal map LabPBR. Memerlukan Normal Map Resource Pack. Daun, tanaman dan LOD jauh dilewati. Tidak mengubah siluet atau kedalaman geometri.
option.POM_STEPS=Langkah Parallax Maksimum
option.POM_STEPS.comment=Jumlah sampel mengikuti sudut pandang, ditambah 3 sampel perbaikan. Nilai tinggi memperjelas celah sempit dengan beban GPU lebih besar.
option.POM_DEPTH=Kedalaman Parallax
option.POM_DEPTH.comment=Kedalaman relatif terhadap satu ubin tekstur. Standar LabPBR adalah 0.25. Nilai nol mematikan perpindahan tekstur.
option.POM_DISTANCE=Jarak Parallax (Blok)
option.POM_DISTANCE.comment=Mulai memudar pada 65% jarak ini. Penelusuran tinggi dilewati setelah batas jarak.

option.CLOUD_RECONSTRUCTION=Rekonstruksi Awan
option.TEMPORAL_CLOUDS=Riwayat Awan
option.TEMPORAL_CLOUDS.comment=Proyeksikan ulang dan batasi sampel awan sebelumnya. Perlu rekonstruksi awan. Matikan jika terlihat jejak.
option.HALF_RES_LIGHTING=Rekonstruksi Pencahayaan
option.HALF_RES_LIGHTING.comment=AO/GI dan light shaft setengah resolusi dengan penjaga tepi. Light shaft memakai dua kali sampel per ray; tepi kedalaman sulit tetap dihitung penuh.

option.CONTACT_HARDENING_SHADOWS=Bayangan matahari kontak
option.CONTACT_HARDENING_SHADOWS.comment=Empat sampel penghalang memperkirakan penumbra matahari, dibatasi lima texel. Memerlukan bayangan dengan 6 atau 8 sampel filter; menambah kerja GPU.

option.AUTO_EXPOSURE=Exposure kamera adaptif
option.AUTO_EXPOSURE.comment=64 sampel luminansi HDR opaque mengatur exposure 0.35-3.0. Adaptasi lebih cepat ke terang dan lebih lambat ke gelap; diterapkan sebelum tone mapping.

option.TEMPORAL_INDIRECT=GI/AO temporal
option.TEMPORAL_INDIRECT.comment=Reproyeksi GI/AO memeriksa kedalaman dan normal dunia setiap sampel. Memerlukan cahaya setengah resolusi. Entitas bergerak, perpindahan kamera dan history tidak valid ditolak.

option.EXPOSURE.comment=Pengali exposure manual. Saat exposure adaptif aktif, mengalikan hasil pengukuran; jika mati, memakai baseline siang/malam.

option.FOG_DENSITY.comment=Kepadatan haze jarak jauh. Udara cerah tidak meredupkan 12 blok terdekat; haze horizon tetap ada. Extinction hujan dan bawah air ditangani terpisah.

option.SVGF_DENOISER=Denoiser GI Berbasis Varians
option.SVGF_DENOISER.comment=Momen luminansi temporal dan tiga pass a-trous berpenjaga tepi. Memerlukan GI temporal setengah resolusi dan compute OpenGL.

option.HARDWARE_PCF=Filter Bayangan Hardware
option.HARDWARE_PCF.comment=Bayangan 4 sampel memakai satu lookup hardware bilinear; 8 sampel memakai empat lookup dan mempertahankan pencarian blocker PCSS. Tepi sedikit berubah. Iris tanpa dukungan memakai filter manual.

# Four gameplay profiles

option.MATERIAL_FILTER=Filter Tekstur Halus
option.MATERIAL_FILTER.comment=Menjaga piksel tekstur dekat tetap tajam. Filter adaptif hanya meratakan detail subpiksel/jauh dan sudut miring; 0 mengikuti filter game.
value.MATERIAL_FILTER.0=Filter Game

# Layered atmosphere
option.ATMOSPHERIC_LIGHTING=Pencahayaan Atmosfer
option.ATMOSPHERIC_LIGHTING.comment=Warna cahaya langit dan pantulan tanah mengikuti ketinggian matahari, hujan dan bayangan awan.
option.CLOUD_LAYERS=Lapisan Awan
option.CLOUD_LAYERS.comment=1: cumulus volumetrik. 2: tambah lembaran awan tengah. 3: tambah cirrus tinggi memanjang. Lapisan tambahan memakai opacity analitik, bukan raymarch volume penuh.
option.CLOUD_LIGHT_SAMPLES=Kualitas Bayangan Dalam Awan
option.CLOUD_LIGHT_SAMPLES.comment=2/4/6 sampel densitas menuju cahaya. Nilai tinggi menambah kedalaman bayangan awan dan biaya GPU.
option.CLOUD_SHADOW_STRENGTH=Kekuatan Bayangan Awan
option.CLOUD_SHADOW_STRENGTH.comment=Batas pengurangan cahaya langsung di bawah awan. Semua lapisan memakai peta bergerak 4096 blok untuk terrain, air dan berkas cahaya.
option.GI_SAMPLES.comment=Ray berbobot cosine per piksel. Ray temporal menjelajah lapisan elevasi. Profil Detail memakai 2 ray.
option.GI_STRENGTH.comment=Kekuatan pantulan berwarna material melalui respons diffuse penerima. Profil Detail memakai 0.65.
option.GI_RADIUS=Radius Pantulan
option.GI_RADIUS.comment=Panjang maksimum tiap ray diffuse lokal dalam blok. Radius lebih luas menjangkau lebih banyak geometri dan menambah biaya tracing.
option.GI_TRACE_STEPS=Langkah Ray Diffuse
option.GI_DISTANCE=Jarak Cahaya Pantul
option.GI_DISTANCE.comment=Jarak GI lokal dari kamera dalam blok, memudar di wilayah luar. LOD jauh mempertahankan ambient dasar.

option.UPSCALE_QUALITY=Upscaling AMD FSR 1
option.UPSCALE_QUALITY.comment=Upscaling spatial untuk Windows dan macOS. Resolusi internal lebih rendah menghemat shading, dengan kompromi detail halus. Tidak membuat frame tambahan.
value.UPSCALE_QUALITY.0=Native (100%)
value.UPSCALE_QUALITY.1=Ultra Quality (77%)
value.UPSCALE_QUALITY.2=Quality (67%)
value.UPSCALE_QUALITY.3=Balanced (59%)
option.UPSCALE_SHARPNESS=Ketajaman FSR RCAS
option.UPSCALE_SHARPNESS.comment=Penajaman adaptif AMD RCAS setelah upscale. Nol menonaktifkan penajaman.

# Current renderer and profiles
screen.POST=Warna & Gambar
screen.INDIRECT=Cahaya Pantul
screen.INDIRECT.comment=Pantulan diffuse lokal beserta smoothing. Depth layar dan shadow-view terbatas; tanpa scene voxel.
screen.PERFORMANCE=Performa & FSR
option.DEPTH_HIERARCHY=Optimasi Hierarki Kedalaman
option.DEPTH_HIERARCHY.comment=Mempercepat ray layar dengan min/max depth konservatif. Memerlukan image/compute opsional; optimasi ini bukan efek cahaya tambahan.
option.CLOUD_FULL_RES=Awan Resolusi Penuh
option.CLOUD_FULL_RES.comment=Render awan beserta history pada resolusi scene asli. Memerlukan rekonstruksi awan; aktif di Extreme. Beban GPU dan memori lebih tinggi.
option.CLOUD_RECONSTRUCTION.comment=Cache awan 2D atau volumetrik pada setengah resolusi. Bentuk dan warna tetap; tepi bisa sedikit lebih lembut. History temporal hanya untuk awan volumetrik. Awan Resolusi Penuh mengganti ukuran buffer.
option.SSGI.comment=Pantulan diffuse berwarna material dari depth layar dan fallback shadow-view yang terlihat matahari. Cakupan terbatas, tanpa tracing seluruh dunia.
option.GI_TRACE_STEPS.comment=Budget langkah depth layar per ray. Fallback shadow-view dibatasi 24 langkah dan Radius Pantulan yang sama.
option.LIGHT_SPACE_FALLBACK=Fallback Pantulan Shadow-View
option.LIGHT_SPACE_FALLBACK.comment=Geometri shadow-map yang terlihat matahari mengisi GI/refleksi terrain di luar layar. Cakupan 2.5D terbatas; refleksi air tidak memakai jalur ini.
profile.comment=Empat tingkat kualitas dengan FSR aktif secara default. Asap memakai partikel Minecraft.
profile.POTATO=Lightweight
profile.POTATO.comment=Bayangan 256 hingga 48 blok; awan 2D ber-cache dan pencahayaan atmosfer; 4 lapis gelombang ringan, refraksi lebih jernih dan pola cahaya di dasar air; FSR Ultra Quality. Motion blur, GI, AO, SSR dan volumetric light mati.
profile.MEDIUM=Balanced
profile.MEDIUM.comment=FSR Ultra Quality; bayangan 1024, awan 12 langkah, AO temporal, refleksi 16 langkah dan 4 lapis gelombang.
profile.HIGH=Detailed
profile.HIGH.comment=FSR Ultra Quality; bayangan 2048, awan 20 langkah, GI 2 ray, refleksi 24 langkah, 6 lapis gelombang dan PBR resource pack. POM bisa dinyalakan manual.
profile.EXTREME=Extreme
profile.EXTREME.comment=FSR Ultra Quality; bayangan 4096 hingga 224 blok; awan resolusi penuh 32 langkah/6 sampel cahaya; GI 8 ray/48 langkah; refleksi 64 langkah, 7 lapis gelombang dan POM 48 langkah. Budget kualitas maksimum; berat.

option.CLOUD_SHADOWS.comment=Bayangan terrain mengikuti awan yang sama di koordinat dunia. Awan 2D memakai atlas kecil; awan volumetrik mengintegrasikan density.
