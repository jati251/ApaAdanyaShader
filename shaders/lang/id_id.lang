# Judul Layar
screen.LIGHTING=Pencahayaan & Atmosfer
screen.SHADOWS=Konfigurasi Bayangan
screen.SKY=Langit & Awan
screen.WATER=Air & Refleksi
screen.WORLD=Dunia & Tumbuhan
screen.POST=Pasca-Proses & Kamera

# Profil
profile.POTATO=Potato (FPS Maksimal)
profile.LOW=Rendah (Bayangan Cepat & FXAA)
profile.MEDIUM=Sedang (Seimbang)
profile.HIGH=Tinggi (Realistis)
profile.ULTRA=Ultra (Maksimal)
profile.EXTREME=Extreme (Sinematik)
profile.comment=Potato: FPS maksimal (tanpa bayangan/awan). Low: Bayangan cepat + FXAA. Medium: Awan 3D + SSAO + pantulan air (SSR) + TAA. High: SSGI + God rays + LabPBR/POM. Ultra: Grafis maksimal gameplay. Extreme: Tampilan sinematik resolusi penuh (DOF + Motion Blur).

# Opsi Pencahayaan
option.SSAO=Screen-Space Ambient Occlusion
option.SSAO.comment=Memberikan bayangan gelap pada sudut dan celah objek. Matikan untuk menghemat bandwidth GPU kentang.
option.SSAO_SAMPLES=Jumlah Sampel SSAO
option.SSAO_SAMPLES.comment=Banyaknya sampel kedalaman untuk menghitung oklusi. Nilai rendah lebih ramah untuk perangkat kentang.
option.SSGI=Screen-Space Indirect Light
option.SSGI.comment=Melacak pantulan cahaya antar permukaan objek. Matikan di GPU kelas bawah.
option.GI_SAMPLES=Jumlah Ray Cahaya
option.GI_STRENGTH=Kekuatan Pantulan Cahaya
option.VOLUMETRIC_LIGHT=Berkas Cahaya (God Rays)
option.VOLUMETRIC_LIGHT.comment=Menampilkan sorot cahaya matahari di udara.
option.VL_SAMPLES=Langkah Sampel God Ray
option.NIGHT_BRIGHTNESS=Kecerahan Cahaya Bulan
option.CAVE_BRIGHTNESS=Kecerahan Gua & Interior
option.CAVE_BRIGHTNESS.comment=Tingkat kecerahan minimal di dalam gua atau ruangan tertutup agar tidak gelap gulita.
option.TORCH_BRIGHTNESS=Kecerahan Obor & Lentera

# Opsi Bayangan
option.SHADOWS=Bayangan Real-Time
option.SHADOWS.comment=Membuat bayangan dinamis matahari dan bulan. Mematikan fitur ini memberikan lonjakan FPS terbesar.
option.shadowMapResolution=Resolusi Peta Bayangan
option.shadowDistance=Jarak Bayangan
option.SHADOW_SAMPLES=Kelembutan Sampel Bayangan
option.SHADOW_SAMPLES.comment=1 sampel menghasilkan bayangan tajam seketika (sangat optimal untuk perangkat kentang). Sampel lebih tinggi menghasilkan gradasi halus.
option.SHADOW_ALPHA_TEST=Uji Alpha Bayangan (Cutout)
option.SHADOW_ALPHA_TEST.comment=Memungkinkan daun dan rumput membentuk bayangan tembus cahaya detail. Matikan untuk mempercepat rendering GPU.
option.CLOUD_SHADOWS=Bayangan Awan Bergerak
option.sunPathRotation=Sudut Rotasi Matahari

# Opsi Langit & Awan
option.CLOUDS=Awan
value.CLOUDS.0=Mati
value.CLOUDS.1=Cepat 2D
value.CLOUDS.2=Volumetrik 3D
option.CLOUDS.comment=Mode render awan. Cepat 2D sangat ringan dan mulus untuk perangkat kentang/low-end. Volumetrik 3D memberikan awan raymarch yang megah dan realistis.
option.CLOUD_DETAIL=Detail Gumpalan Awan (Noise 3D)
option.CLOUD_DETAIL.comment=Menambahkan mikro-tekstur gumpalan detail pada awan. Matikan pada perangkat kentang untuk melewati kalkulasi noise 3D.
option.CLOUD_STEPS=Langkah Raymarch Awan
option.CLOUD_COVERAGE=Kepadatan Awan
option.CLOUD_ALTITUDE=Ketinggian Dasar Awan
option.STARS=Bintang Langit Malam
option.SUN_MOON_GLOW=Pendar Korona Matahari & Bulan
option.FOG_ENABLED=Kabut Atmosfer
option.FOG_DENSITY=Kepadatan Kabut

# Opsi Air
option.WATER_REFRACTION=Pembiasan Cahaya di Bawah Air
option.WATER_REFRACTION.comment=Membias permukaan di bawah air. Matikan pada perangkat kentang untuk menghindari pembacaan ganda buffer kedalaman.
option.WATER_CAUSTICS=Pola Kaustik Dasar Air
option.WATER_CAUSTICS.comment=Pola gelombang pantulan sinar matahari di dasar sungai dan laut.
option.WATER_FOAM=Busa Ombak Pesisir
option.WATER_FOAM.comment=Busa putih di tepi air. Matikan pada perangkat kentang untuk menghemat komputasi noise.
option.SSR=Refleksi Air Ray Tracing (SSR)
option.SSR.comment=Melacak pantulan blok dan mob di permukaan air.
option.SSR_STEPS=Langkah Ray Refleksi
option.WATER_OCTAVES=Oktaf Gelombang Air
option.WATER_OCTAVES.comment=Banyaknya frekuensi gelombang air. Gunakan 2 oktaf untuk FPS maksimal pada perangkat kentang.
option.WATER_WAVES=Kekuatan Riak Gelombang Air
option.WATER_CLARITY=Kejernihan Air
option.WATER_ROUGHNESS=Kekasaran Permukaan Air

# Opsi Dunia & Tumbuhan
option.WAVING_FOLIAGE=Gerakan Angin Tanaman
option.WAVING_PLANTS=Goyangan Rumput, Bunga & Tanaman
option.WAVING_LEAVES=Goyangan Daun Pohon
option.WIND_SPEED=Kecepatan Angin
option.RAIN_PUDDLES=Genangan Air Hujan Dinamis
option.RAIN_PUDDLES.comment=Membuat genangan basah mengkilap saat hujan. Matikan untuk meningkatkan FPS saat cuaca hujan.
option.RESOURCE_NORMALS=Normal Map Resource Pack

# Opsi Pasca-Proses & Color Grading
option.COLOR_PROFILE=Gaya Warna / Varian (Color Look)
value.COLOR_PROFILE.0=Alami (Natural / Balanced)
value.COLOR_PROFILE.1=Fantasi Cerah (Vibrant Fantasy)
value.COLOR_PROFILE.2=Sinematik Teal & Oranye (Hollywood)
value.COLOR_PROFILE.3=Golden Hour (Senja Hangat)
value.COLOR_PROFILE.4=Nordik Dingin (Boreal / Salju)
value.COLOR_PROFILE.5=Film Analog Retro 35mm
value.COLOR_PROFILE.6=Bleach Bypass (Kontras Gelap)
value.COLOR_PROFILE.7=Cyberpunk (Neon Elektrik)
option.COLOR_PROFILE.comment=Pilihan varian gaya grading warna. Mengubah palet warna keseluruhan, atmosfer suasana, dan nuansa pencahayaan.
option.TONEMAP_OPERATOR=Kurva Tonemapping
value.TONEMAP_OPERATOR.0=ACES Filmic
value.TONEMAP_OPERATOR.1=AgX (Standar Blender Modern)
value.TONEMAP_OPERATOR.2=Khronos PBR Netral
value.TONEMAP_OPERATOR.3=Uncharted 2 (Hable)
value.TONEMAP_OPERATOR.4=Reinhard-Jodie
value.TONEMAP_OPERATOR.5=Linear (Vanilla)
option.TONEMAP_OPERATOR.comment=Metode kompresi kecerahan tinggi (HDR). AgX mencegah warna terpotong/pudar menjadi kuning aneh; ACES memberikan kontras film klasik.
option.COLOR_VIBRANCE=Vibrance Pintar
option.COLOR_VIBRANCE.comment=Secara cerdas meningkatkan warna-warna redup/pucat tanpa membuat warna yang sudah terang menjadi terlalu mencolok atau merusak warna kulit.
option.COLOR_SATURATION=Saturasi Warna
option.COLOR_CONTRAST=Kontras Warna
option.EXPOSURE=Pencahayaan Kamera (Exposure)
option.COLOR_TEMPERATURE=Keseimbangan Putih (Suhu Warna)
option.COLOR_TEMPERATURE.comment=Menggeser keseimbangan warna antara hangat kekuningan/emas dan dingin kebiruan.
option.COLOR_TINT=Keseimbangan Putih (Tint Warna)
option.COLOR_TINT.comment=Menyesuaikan pergeseran warna antara hijau dan magenta/ungu.
option.BLOOM=Efek Pendaran Cahaya (Bloom)
option.BLOOM.comment=Memberikan pendaran lembut di sekitar sumber cahaya terang. Otomatis dilewati saat dimatikan.
option.BLOOM_STRENGTH=Kekuatan Bloom
option.TAA=Stabilisasi Temporal
option.TAA.comment=History HDR dengan validasi depth, clipping warna, dan reproyeksi kamera. Gunakan bersama FXAA untuk tepi geometri; tidak memakai jitter.
option.TAA_BLEND=Akumulasi Temporal TAA
option.TAA_BLEND.comment=Bobot akumulasi riwayat frame sebelumnya. Nilai lebih tinggi memberikan stabilitas maksimal; nilai lebih rendah meningkatkan responsivitas gerakan.
option.TAA_SHARPENING=Penajaman Adaptif Kontras (CAS)
option.TAA_SHARPENING.comment=Menerapkan filter penajam kontras adaptif untuk mengembalikan kejernihan tekstur saat perpaduan temporal aktif.
option.TAA_SHARPEN_STRENGTH=Kekuatan Ketajaman TAA
option.TAA_SHARPEN_STRENGTH.comment=Mengontrol intensitas filter penajam. Nilai tinggi menghasilkan tekstur sangat tajam; nilai rendah memberikan gambar sinematik yang lembut.
option.FXAA=Penghalusan Tepi (FXAA)
option.FXAA.comment=Filter penghalus tepi berbasis screen-space. Bekerja bersama TAA untuk memberikan tepi halus tanpa getaran kamera.
option.VIGNETTE=Vignette Lensa
option.VIGNETTE_STRENGTH=Kekuatan Vignette
option.CHROMATIC_ABERRATION=Aberasi Kromatik (Lensa)
option.CHROMATIC_ABERRATION.comment=Mensimulasikan pembiasan optik lensa fisik kamera pada pinggiran dan sudut layar.
option.CA_STRENGTH=Kekuatan Aberasi Lensa
option.FILM_GRAIN=Film Grain 35mm
option.FILM_GRAIN.comment=Menambahkan butiran film analog organik untuk meningkatkan kesan sinematik dan mencegah garis pita warna (banding).
option.FILM_GRAIN_STRENGTH=Intensitas Film Grain
option.COLOR_DITHERING=Dithering Warna Teratur

screen.CAMERA=Kamera & Efek Gerakan
screen.PARTICLES=Partikel & Cuaca
option.MOTION_BLUR=Motion Blur (Kabur Gerakan)
option.MOTION_BLUR.comment=Mensimulasikan efek blur rana kamera sinematik saat bergerak dan memutar pandangan.
option.MOTION_BLUR_LOW_LATENCY=Mode Latensi Rendah (Low Latency)
option.MOTION_BLUR_LOW_LATENCY.comment=Mengoptimalkan motion blur untuk permainan kompetitif/PvP. Membatasi sampel ke 5 dan mereduksi radius blur untuk meminimalkan input lag dan latensi layar.
option.MOTION_BLUR_STRENGTH=Kekuatan Motion Blur
option.MOTION_BLUR_STRENGTH.comment=Mengatur panjang jejak blur gerakan. 0.50 setara dengan sudut rana sinematik 180 derajat.
option.MOTION_BLUR_SAMPLES=Sampel Motion Blur
option.MOTION_BLUR_SAMPLES.comment=Jumlah sampel di sepanjang lintasan blur. Sampel lebih tinggi menghasilkan jejak lebih mulus dengan sedikit beban GPU tambahan.
option.MOTION_BLUR_HAND=Blur Tangan & Item
option.MOTION_BLUR_HAND.comment=Menerapkan motion blur pada tangan dan item yang dipegang. Matikan agar tangan tetap tajam saat kamera berputar.
option.RESOURCE_SPECULAR=Kilap & Emisi LabPBR
option.RESOURCE_SPECULAR.comment=Membaca smoothness, F0, logam, hamburan bawah permukaan dan emisi. Logam memakai albedo sebagai F0. Peta tinggi diatur melalui POM; porositas belum digunakan.
option.SPECULAR_AA=Kurangi Kedipan Kilap
option.SPECULAR_AA.comment=Melebarkan kilap yang lebih kecil dari piksel agar air dan normal map tidak berkelip berlebihan.
option.SOFT_PARTICLES=Pertemuan Partikel Halus
option.SOFT_PARTICLES.comment=Memudarkan partikel transparan saat menyentuh blok padat. Tidak menambah partikel baru.
option.PARTICLE_SOFTNESS=Jarak Pudar Partikel
option.PARTICLE_LIGHTING=Cahaya & Bayangan Partikel
option.WEATHER_OPACITY=Kepekatan Hujan & Salju
option.DOF=Kedalaman Fokus (DOF)
option.DOF.comment=Blur lensa sebelum pemetaan warna. Area fokus melewati proses blur. Matikan untuk gambar tajam dan beban GPU lebih rendah.
option.DOF_AUTOFOCUS=Fokus Otomatis
option.DOF_AUTOFOCUS.comment=Mengikuti jarak bidikan dengan transisi halus. Matikan untuk memilih jarak fokus tetap.
option.DOF_FOCUS_DISTANCE=Jarak Fokus Manual (Blok)
option.DOF_FOCAL_LENGTH=Panjang Fokus Lensa (mm)
option.DOF_FSTOP=Bukaan Lensa (f-number)
option.DOF_FSTOP.comment=Nilai kecil membuat latar lebih kabur. Tidak mengubah pencahayaan kamera.
option.DOF_SAMPLES=Sampel Bokeh
option.DOF_MAX_RADIUS=Radius Blur Maksimum (Piksel)

option.POM=Tekstur Timbul (POM)
option.POM.comment=Kedalaman dari alpha normal map LabPBR. Memerlukan Normal Map Resource Pack. Daun, tanaman dan LOD jauh dilewati. Tidak mengubah siluet atau kedalaman geometri.
option.POM_STEPS=Langkah Parallax Maksimum
option.POM_STEPS.comment=Jumlah sampel mengikuti sudut pandang, ditambah 3 sampel perbaikan. Nilai tinggi memperjelas celah sempit dengan beban GPU lebih besar.
option.POM_DEPTH=Kedalaman Parallax
option.POM_DEPTH.comment=Kedalaman relatif terhadap satu ubin tekstur. Standar LabPBR adalah 0.25. Nilai nol mematikan perpindahan tekstur.
option.POM_DISTANCE=Jarak Parallax (Blok)
option.POM_DISTANCE.comment=Mulai memudar pada 65% jarak ini. Penelusuran tinggi dilewati setelah batas jarak.

screen.PERFORMANCE=Performa & Rekonstruksi
option.CLOUD_RECONSTRUCTION=Rekonstruksi Awan Volumetrik
option.CLOUD_RECONSTRUCTION.comment=Hitung awan pada setengah lebar/tinggi; langit tetap resolusi asli. Matikan untuk pembanding resolusi penuh.
option.TEMPORAL_CLOUDS=Riwayat Awan
option.TEMPORAL_CLOUDS.comment=Proyeksikan ulang dan batasi sampel awan sebelumnya. Perlu rekonstruksi awan. Matikan jika terlihat jejak.
option.HALF_RES_LIGHTING=Rekonstruksi Cahaya Tidak Langsung
option.HALF_RES_LIGHTING.comment=AO/GI setengah resolusi dengan pemeriksaan kedalaman, normal, dan emisi. Tepi sulit dihitung penuh.
option.HALF_RES_DOF=Rekonstruksi Blur Lensa
option.HALF_RES_DOF.comment=Hitung bokeh besar pada setengah lebar/tinggi. Fokus, tangan, dan tepi kedalaman tetap ditangani pada resolusi asli.

option.UPSCALE_QUALITY=Upscaling AMD FSR 1
option.UPSCALE_QUALITY.comment=Upscaling spatial untuk Windows dan macOS. Resolusi internal lebih rendah menghemat shading, dengan kompromi detail halus. Tidak membuat frame tambahan.
value.UPSCALE_QUALITY.0=Native (100%)
value.UPSCALE_QUALITY.1=Ultra Quality (77%)
value.UPSCALE_QUALITY.2=Quality (67%)
value.UPSCALE_QUALITY.3=Balanced (59%)
option.UPSCALE_SHARPNESS=Ketajaman FSR RCAS
option.UPSCALE_SHARPNESS.comment=Penajaman adaptif AMD RCAS setelah upscale. Nol menonaktifkan penajaman.
